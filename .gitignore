# Vercel CLI link state (project + org ids, created by `vercel link` / `vercel dev`)
.vercel/

# Environment / secrets
.env
.env.*
!.env.example

# Node — no package.json today, but shape-pouch.mjs shells out to gltfpack
# and anything added later will drop these here.
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Claude Code local overrides (launch.json is shared config and stays tracked)
.claude/settings.local.json

# Editor / OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
